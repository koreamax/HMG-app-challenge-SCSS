<mxfile host="drawio" agent="jaejeok make_drawio.py"><diagram id="arch" name="시스템 구성"><mxGraphModel dx="1700" dy="1030" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1710" pageHeight="1030" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="적재적소 시스템 구성 (2026-11-14 코드 기준)" style="text;html=1;fontFamily=Pretendard;fontSize=22;fontColor=#161b22;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1200" height="40" as="geometry"/></mxCell><mxCell id="c3" value="실선 = 만들어서 동작함 · 점선 = 계획 · 아이디어 (만들지 않음) · 파란 테두리 = 판정 엔진" style="text;html=1;fontFamily=Pretendard;fontSize=12.5;fontColor=#4a525d;align=right;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1060" y="12" width="640" height="32" as="geometry"/></mxCell><mxCell id="c4" value="Pleos Connect 차량 (AAOS)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Pretendard;fillColor=#eef2f6;strokeColor=#c4ced9;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;fontSize=16;fontStyle=1;fontColor=#161b22;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="410" height="690" as="geometry"/></mxCell><mxCell id="c5" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#161b22;margin-bottom:4px&quot;&gt;AAOS 표준 API&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;color:#2f3741;line-height:1.45&quot;&gt;속도 10 Hz · 기어 · 조향 (CarPropertyManager)&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;color:#2f3741;line-height:1.45&quot;&gt;주행 규제 (CarUxRestrictionsManager)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Pretendard;fillColor=#ffffff;strokeColor=#c4ced9;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="370" height="74" as="geometry"/></mxCell><mxCell id="c6" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#161b22;margin-bottom:4px&quot;&gt;Pleos Vehicle SDK 2.3.2&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;color:#2f3741;line-height:1.45&quot;&gt;기어 · 브레이크 · 핸들 각 · 뒷문 · 주행거리&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Pretendard;fillColor=#ffffff;strokeColor=#c4ced9;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="370" height="74" as="geometry"/></mxCell><mxCell id="c7" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#161b22;margin-bottom:4px&quot;&gt;Pleos NaviHelper 3.0.5&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;color:#2f3741;line-height:1.45&quot;&gt;경유지 넣기 · 주의 지점 · 경로 · 도착 이벤트&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Pretendard;fillColor=#ffffff;strokeColor=#c4ced9;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="370" height="74" as="geometry"/></mxCell><mxCell id="c8" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#161b22;margin-bottom:4px&quot;&gt;Pleos TextToSpeech 3.3.1&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;color:#2f3741;line-height:1.45&quot;&gt;정해진 한 문장 말하기 (기기 안, ko-KR)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Pretendard;fillColor=#ffffff;strokeColor=#c4ced9;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="370" height="74" as="geometry"/></mxCell><mxCell id="c9" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#161b22;margin-bottom:4px&quot;&gt;Pleos SpeechToText 3.3.1&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;color:#2f3741;line-height:1.45&quot;&gt;운전자의 &quot;네&quot;를 5초만 듣기 (기기 안, 저장 안 함)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Pretendard;fillColor=#ffffff;strokeColor=#c4ced9;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="370" height="74" as="geometry"/></mxCell><mxCell id="c10" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#161b22;margin-bottom:4px&quot;&gt;Pleos FusedLocation 1.1.3&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;color:#2f3741;line-height:1.45&quot;&gt;위치 · 쉼터 200 m 안 도착 알림&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Pretendard;fillColor=#ffffff;strokeColor=#c4ced9;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="370" height="74" as="geometry"/></mxCell><mxCell id="c11" value="Pleos 내비게이션 앱이 경유지를 받아 안내합니다. 외부 음성 인식 서비스는 쓰지 않습니다." style="text;html=1;fontFamily=Pretendard;fontSize=12.5;fontColor=#4a525d;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="370" height="80" as="geometry"/></mxCell><mxCell id="c12" value="내비 판 Android 앱 (Kotlin)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Pretendard;fillColor=#eef2f6;strokeColor=#c4ced9;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;fontSize=16;fontStyle=1;fontColor=#161b22;" vertex="1" parent="1"><mxGeometry x="460" y="60" width="410" height="690" as="geometry"/></mxCell><mxCell id="c13" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#161b22;margin-bottom:4px&quot;&gt;VehicleSource&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#2f3741;line-height:1.45&quot;&gt;AAOS 차량 값 읽기&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Pretendard;fillColor=#ffffff;strokeColor=#c4ced9;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="480" y="11