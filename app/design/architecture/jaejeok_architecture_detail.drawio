1b22;margin-bottom:4px&quot;&gt;MonitorService&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#2f3741;line-height:1.45&quot;&gt;포그라운드 서비스&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#2f3741;line-height:1.45&quot;&gt;0.1 s 틱으로&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#2f3741;line-height:1.45&quot;&gt;지도가 앞이어도 감시&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Pretendard;fillColor=#ffffff;strokeColor=#c4ced9;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="700" y="366" width="150" height="130" as="geometry"/></mxCell><mxCell id="c17" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#161b22;margin-bottom:4px&quot;&gt;MainActivity&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#2f3741;line-height:1.45&quot;&gt;WebView 로 웹 앱&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#2f3741;line-height:1.45&quot;&gt;낮 · 밤 테마&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Pretendard;fillColor=#ffffff;strokeColor=#c4ced9;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="700" y="512" width="150" height="122" as="geometry"/></mxCell><mxCell id="c18" value="같은 코드로 휴대폰 판 APK 도 만듭니다 (차량 SDK 없이)." style="text;html=1;fontFamily=Pretendard;fontSize=12.5;fontColor=#4a525d;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="480" y="650" width="370" height="80" as="geometry"/></mxCell><mxCell id="c19" value="웹 앱 (WebView 안, TypeScript · React)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Pretendard;fillColor=#eef2f6;strokeColor=#c4ced9;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;fontSize=16;fontStyle=1;fontColor=#161b22;" vertex="1" parent="1"><mxGeometry x="900" y="60" width="450" height="690" as="geometry"/></mxCell><mxCell id="c20" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#161b22;margin-bottom:4px&quot;&gt;실행 루프 (runtime) · 10 Hz&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;color:#2f3741;line-height:1.45&quot;&gt;차량 값과 키트 값을 합쳐 엔진에 넣고&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;color:#2f3741;line-height:1.45&quot;&gt;결과를 화면과 음성 순서로 보냄&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;color:#2f3741;line-height:1.45&quot;&gt;음성: Pleos TTS (오류면 Android TTS)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Pretendard;fillColor=#ffffff;strokeColor=#c4ced9;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="920" y="110" width="410" height="150" as="geometry"/></mxCell><mxCell id="c21" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#161b22;margin-bottom:4px&quot;&gt;판정 엔진 (engine) · 단위 시험 26개&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;color:#2f3741;line-height:1.45&quot;&gt;한계 = 0.8 × μ × (1 + 2 ΣT sin α ÷ mg)&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;color:#2f3741;line-height:1.45&quot;&gt;기준: 앞 0.8 g, 옆 · 뒤 0.5 g (EN 12195-1)&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;color:#2f3741;line-height:1.45&quot;&gt;제동 · 회전 추정 × 1.25 (키트 없을 때)&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;color:#2f3741;line-height:1.45&quot;&gt;상태 · 말할 때 · 정해진 문장 · 운송장 기록&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Pretendard;fillColor=#ffffff;strokeColor=#1c69d4;strokeWidth=2.2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="920" y="276" width="410" height="170" as="geometry"/></mxCell><mxCell id="c22" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#161b22;margin-bottom:4px&quot;&gt;내비 판 화면&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#2f3741;line-height:1.45&quot;&gt;정차: 3D 확인 · 다시 묶기&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#2f3741;line-height:1.45&quot;&gt;주행: 음성 (승인 뒤&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#2f3741;line-height:1.45&quot;&gt;색 하나와 한 줄)&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#2f3741;line-height:1.45&quot;&gt;기록&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Pretendard;fillColor=#ffffff;strokeColor=#c4ced9;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="920" y="462" width="200" height="160" as="geometry"/></mxCell><mxCell id="c23" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#161b22;margin-bottom:4px&quot;&gt;적재함 3D 트윈&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#2f3741;line-height:1.45&quot;&gt;three.js&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#2f3741;line-height:1.45&quot;&gt;짐 · 벨트 · 밀린 자리&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#2f3741;line-height:1.45&quot;&gt;번호 배지로 할 일&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Pretendard;fillColor=#ffffff;strokeColor=#c4ced9;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1130" y="462" width="200" height="160" as="geometry"/></mxCell><mxCell id="c24" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#161b22;margin-bottom:4px&quot;&gt;시연 자료: isaac-runs.json&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#2f3741;line-height:1.45&quot;&gt;Isaac Sim 주행 기록을 키트 값으로 재생 (센서 키트 자리)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Pretendard;fillColor=#f6f8fa;strokeColor=#c4ced9;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="920" y="640" width="410" height="80" as="geometry"/></mxCell><mxCell id="c25" value="운전자" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Pretendard;fillColor=#eef2f6;strokeColor=#c4ced9;strokeWidth=1.2;align=left;verticalAlign=t